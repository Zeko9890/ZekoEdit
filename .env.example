# ZekoEdit — environment template.
# Nothing in here is required for the app to boot. Copy to .env.local only if
# you want to change the defaults below.
#
# NEVER put a creator's Gemini API key in this file. Keys arrive per job in the
# request body and live only in server memory.

# Optional: override the Gemini model used for all analysis passes.
# GEMINI_MODEL=gemini-2.5-flash

# Optional: absolute path to an ffmpeg binary. If unset, ZekoEdit uses the
# bundled ffmpeg-static binary, then falls back to `ffmpeg` on PATH.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Optional: where job working directories are written.
# ZEKO_DATA_DIR=C:\ZekoEdit\data\jobs
